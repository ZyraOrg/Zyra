  "accounts": [
    {
      "name": "Platform",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "authority",
            "type": "publicKey"
          },
          {
            "name": "platformWallet",
            "type": "publicKey"
          },
          {
            "name": "campaignCount",
            "type": "u64"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "Campaign",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "campaignId",
            "type": "u64"
          },
          {
            "name": "payoutAddress",
            "type": "publicKey"
          },
          {
            "name": "goal",
            "type": "u64"
          },
          {
            "name": "raised",
            "type": "u64"
          },
          {
            "name": "status",
            "type": {
              "defined": "CampaignStatus"
            }
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    }
  ],
  "types": [
    {
      "name": "CampaignStatus",
      "type": {
        "kind": "enum",
        "variants": [
          {
            "name": "Active"
          },
          {
            "name": "Ended"
          },
          {
            "name": "Completed"
          }
        ]
      }
    }
  ],
  "errors": [
    {
      "code": 6000,
      "name": "Unauthorized",
      "msg": "You are not authorized to perform this action"
    },
    {
      "code": 6001,
      "name": "WrongCampaign",
      "msg": "Campaign ID does not match"
    },
    {
      "code": 6002,
      "name": "CampaignNotActive",
      "msg": "Campaign is not active"
    },
    {
      "code": 6003,
      "name": "InvalidCampaignStatus",
      "msg": "Campaign status does not allow this action"
    },
    {
      "code": 6004,
      "name": "AmountTooLow",
      "msg": "Contribution amount is below the minimum of 1 USDT"
    },
    {
      "code": 6005,
      "name": "NoFundsToRelease",
      "msg": "No funds available to release"
    },
    {
      "code": 6006,
      "name": "InvalidGoal",
      "msg": "Goal must be greater than zero"
    }
  ]
